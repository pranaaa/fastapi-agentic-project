# --- Backend ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# LLM (Groq free tier by default — get a key at https://console.groq.com)
# gpt-oss-120b is the strongest free-tier open-source model on Groq (65K max output).
# For faster/cheaper: openai/gpt-oss-20b or llama-3.1-8b-instant.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_LIGHT=llama-3.1-8b-instant
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=3500
LLM_TEMPERATURE=0.4

# For local Ollama instead of Groq, use:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=

# Optional trend-data sources
# Tavily: free tier 1K searches/month → grounds trend research in real web data
# Sign up at https://tavily.com and set the key here.
TAVILY_API_KEY=

# Legacy — Trends MCP (optional, mostly superseded by Tavily)
TRENDS_MCP_API_KEY=
TRENDS_MCP_BASE_URL=https://api.trendsmcp.ai/api

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_RUN_PER_HOUR=10

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
